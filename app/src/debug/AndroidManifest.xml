<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Runs LeakWatchSetup as the process starts. Debug builds only:
             the leak detector is not in a release build at all. -->
        <provider
            android:name=".LeakWatchSetup"
            android:authorities="${applicationId}.leak-watch-setup"
            android:exported="false" />
        <!-- JP fork: adb-only drawer layout hook (see JpDebugReceiver). DUMP is
             held by the shell, not by apps. -->
        <receiver
            android:name=".jp.JpDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="jp.DUMP_APPS" />
                <action android:name="jp.SET_GROUPS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
